VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Contabo Object Storage (server-side only; never prefix these with VITE_)
S3_ENDPOINT=https://sin1.contabostorage.com
S3_REGION=default
S3_BUCKET=tsls
S3_ACCESS_KEY_ID=your_contabo_access_key_here
S3_SECRET_ACCESS_KEY=your_contabo_secret_key_here
S3_MAX_FILE_SIZE_BYTES=52428800
S3_ALLOWED_ORIGINS=https://dashboard-operasional-sekolah.vercel.app,http://localhost:5173,http://127.0.0.1:5173
